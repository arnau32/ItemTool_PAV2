# ============================================================
# Monorepo .gitignore
# Compatible with:
# - Unity projects inside subfolders
# - Visual Studio / WPF / .NET projects
# - JetBrains Rider / IntelliJ-based IDEs
# - VS Code
#
# IMPORTANT:
# - Do NOT ignore *.meta: Unity needs .meta files tracked.
# - Do NOT ignore *.csproj or *.sln globally: WPF/.NET projects need them.
# ============================================================


# ============================================================
# OS / System files
# ============================================================

.DS_Store
.AppleDouble
.LSOverride

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

*.swp
*.swo
*~


# ============================================================
# Unity generated folders
# Works even if the Unity project is NOT at repo root.
# ============================================================

**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]og/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/

**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Unity crash/system info
sysinfo.txt

# Unity generated debug/meta files for old Mono/Unity outputs
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity / mobile build outputs
*.apk
*.aab
*.unitypackage
*.app

# Gradle / Android generated cache
.gradle/

# Autogenerated JetBrains Rider plugin inside Unity projects
**/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*/

# Packed Addressables
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Addressables assets
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/


# ============================================================
# Unity files that MUST stay tracked
# ============================================================

!**/[Aa]ssets/**/*.meta
!**/[Pp]roject[Ss]ettings/**
!**/[Pp]ackages/manifest.json
!**/[Pp]ackages/packages-lock.json


# ============================================================
# Visual Studio / .NET / WPF
# ============================================================

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio cache
**/.vs/

# Build results
**/[Dd]ebug/
**/[Dd]ebugPublic/
**/[Rr]elease/
**/[Rr]eleases/
**/x64/
**/x86/
**/[Ww][Ii][Nn]32/
**/[Aa][Rr][Mm]/
**/[Aa][Rr][Mm]64/
**/bld/
**/[Bb]in/
**/[Oo]bj/
**/[Ll]og/
**/[Ll]ogs/
artifacts/

# .NET generated files
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# Visual Studio generated/build files
*_i.c
*_p.c
*_h.h
*.ilk
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
