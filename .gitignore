*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
*.opendb
*.VC.db
*.VC.VC.opendb

# Mono crash files
mono_crash.*

# Test results / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# Profiling / benchmarking
BenchmarkDotNet.Artifacts/
*.psess
*.vsp
*.vspx
*.sap
*.e2e

# ReSharper / Rider extras
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.sln.iml

# NCrunch / other VS tooling
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*
AutoTest.Net/
.axoCover/*
!.axoCover/settings.json

# Publish / deployment outputs
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# Packages / installers generated by builds
*.nupkg
*.snupkg
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload
*.cab
*.msi
*.msix
*.msm
*.msp

# SQL Server local DB files
*.mdf
*.ldf
*.ndf

# MSBuild logs
*.binlog

# Misc VS generated folders/files
Generated\ Files/
Generated_Code/
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
MigrationBackup/
FakesAssemblies/
OpenCover/
ASALocalRun/
.localhistory/
.vshistory/
.history/
.mfractor/
.ionide/
FodyWeavers.xsd


# ============================================================
# JetBrains IDEs / Rider
# Keeps shared project config possible, ignores user/cache noise.
# If your team does NOT want to track any JetBrains config, uncomment:
# **/.idea/
# ============================================================

**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/**/usage.statistics.xml
**/.idea/**/dictionaries/
**/.idea/**/shelf/

**/.idea/**/aws.xml
**/.idea/**/contentModel.xml

**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.local.xml
**/.idea/**/sqlDataSources.xml
**/.idea/**/dynamic.xml
**/.idea/**/uiDesigner.xml
**/.idea/**/dbnavigator.xml

**/.idea/**/gradle.xml
**/.idea/**/libraries/
**/.idea/**/mongoSettings.xml
**/.idea/**/sonarlint/
**/.idea/**/sonarIssues.xml
**/.idea/**/markdown-navigator.xml
**/.idea/**/markdown-navigator-enh.xml
**/.idea/**/markdown-navigator/
**/.idea/$CACHE_FILE$
**/.idea/codestream.xml
**/.idea/**/azureSettings.xml
**/.idea/httpRequests/
**/.idea/caches/

*.iws
.idea_modules/
cmake-build-*/
out/
atlassian-ide-plugin.xml


# ============================================================
# VS Code
# Keeps useful workspace defaults, ignores personal/editor noise.
# ============================================================

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace


# ============================================================
# Node / frontend, if any tool project uses it
# ============================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.sass-cache/


# ============================================================
# Python, if scripts/tools use it
# ============================================================

__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/


# ============================================================
# Secrets / local config
# Add project-specific examples as needed.
# ============================================================

.env
.env.*
!.env.example
*.pfx
*.publishsettings


# ============================================================
# IMPORTANT ALLOWLIST
# These are intentionally NOT ignored:
# - *.meta      Unity asset identity files
# - *.csproj    WPF/.NET project files
# - *.sln       Visual Studio solution files
# - Packages/manifest.json and packages-lock.json for Unity
# ============================================================