<UserControl
    x:Class="ItemTool.App.Views.ItemEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:ItemTool.App.Views.Shared"
    xmlns:itemEditor="clr-namespace:ItemTool.App.Views.ItemEditor">

    <Border
        Padding="12"
        Background="#303030"
        BorderBrush="#555555"
        BorderThickness="1">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Editor}">

                <shared:ToolAssetHeader
                    Title="{Binding HeaderTitle}"
                    Subtitle="{Binding HeaderSubtitle}"
                    TechnicalInfo="{Binding HeaderTechnicalInfo}"
                    BadgeText="{Binding HeaderBadgeText}"
                    PreviewText="{Binding HeaderPreviewText}"
                    PreviewImageSource="{Binding HeaderPreviewImageSource}"
                    AccentBrush="{Binding HeaderKindBrush}"
                    BadgeBackground="{Binding HeaderKindBrush}"
                    PreviewBackground="{Binding HeaderRarityBrush}"
                    SaveButtonText="Save Item"
                    SaveButtonVisibility="Visible"
                    SaveCommand="{Binding DataContext.Items.SaveSelectedItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- Validation -->
                <shared:ToolValidationBox
                    Title="Validation Summary"
                    BoxHeight="75"
                    Text="{Binding DataContext.Items.ValidationSummary, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- Preview -->
                <shared:ToolSection SectionTitle="Dimensions Preview">
                    <shared:ToolDimensionPreview
                        CellColumns="{Binding SelectedItem.SlotDimension.Width}"
                        CellRows="{Binding SelectedItem.SlotDimension.Height}" />
                </shared:ToolSection>

                <!-- General -->
                <itemEditor:GeneralItemSection />

                <!-- Dimensions -->
                <itemEditor:SlotDimensionSection />

                <!-- Equipable -->
                <itemEditor:EquipableSection />

                <!-- Weapon -->
                <itemEditor:WeaponSection />

                <!-- Consumable -->
                <itemEditor:ConsumableSection />

                <!-- Collectable -->
                <itemEditor:CollectableSection />

                <!-- Used In Loot Tables -->
                <shared:ToolSection SectionTitle="Used In Loot Tables">
                    <StackPanel
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                Opacity="0.75"
                                Text="{Binding SelectedItemUsageSummary}" />

                            <Button
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Command="{Binding RefreshSelectedItemUsagesCommand}"
                                Content="Refresh" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding SelectedItemLootUsages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,6"
                                        Padding="8"
                                        Background="#252525"
                                        BorderBrush="#444444"
                                        BorderThickness="1">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    FontWeight="Bold"
                                                    Text="{Binding Title}" />

                                                <TextBlock
                                                    FontSize="11"
                                                    Opacity="0.7"
                                                    Text="{Binding Subtitle}" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                MinWidth="32"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.NavigateToLootTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding LootTableId}"
                                                Content="↗" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </shared:ToolSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>