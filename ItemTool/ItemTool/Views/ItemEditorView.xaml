<UserControl
    x:Class="ItemTool.App.Views.ItemEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:ItemTool.App.Views.Shared"
    xmlns:itemEditor="clr-namespace:ItemTool.App.Views.ItemEditor">

    <Border
        Padding="12"
        Background="#303030"
        BorderBrush="#555555"
        BorderThickness="1">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Editor}">

                <shared:ToolAssetHeader
                    Title="{Binding HeaderTitle}"
                    Subtitle="{Binding HeaderSubtitle}"
                    TechnicalInfo="{Binding HeaderTechnicalInfo}"
                    BadgeText="{Binding HeaderBadgeText}"
                    PreviewText="{Binding HeaderPreviewText}"
                    AccentBrush="{Binding HeaderKindBrush}"
                    BadgeBackground="{Binding HeaderKindBrush}"
                    PreviewBackground="{Binding HeaderRarityBrush}" />

                <!-- Validation -->
                <shared:ToolValidationBox
                    Title="Validation Summary"
                    BoxHeight="75"
                    Text="{Binding DataContext.Items.ValidationSummary, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- Preview -->
                <shared:ToolSection SectionTitle="Dimensions Preview">
                    <shared:ToolDimensionPreview
                        CellColumns="{Binding SelectedItem.SlotDimension.Width}"
                        CellRows="{Binding SelectedItem.SlotDimension.Height}" />
                </shared:ToolSection>

                <!-- General -->
                <itemEditor:GeneralItemSection />

                <!-- Dimensions -->
                <itemEditor:SlotDimensionSection />

                <!-- Equipable -->
                <itemEditor:EquipableSection />

                <!-- Weapon -->
                <itemEditor:WeaponSection />

                <!-- Consumable -->
                <itemEditor:ConsumableSection />

                <!-- Collectable -->
                <itemEditor:CollectableSection />
                
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>