<UserControl
    x:Class="ItemTool.App.Views.ItemEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:ItemTool.App.Views.Shared"
    xmlns:itemEditor="clr-namespace:ItemTool.App.Views.ItemEditor">

    <Border
        Padding="12"
        Background="#303030"
        BorderBrush="#555555"
        BorderThickness="1">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Editor}">

                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="Item Editor" />

                <!-- Validation -->
                <shared:ToolValidationBox
                    Title="Validation Summary"
                    BoxHeight="75"
                    Text="{Binding DataContext.ValidationSummary, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- Preview -->
                <shared:ToolSection SectionTitle="Dimensions Preview">
                    <TextBox
                        Height="110"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding DataContext.DimensionPreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                        TextWrapping="NoWrap" />
                </shared:ToolSection>

                <!-- General -->
                <itemEditor:GeneralItemSection />

                <!-- Dimensions -->
                <itemEditor:SlotDimensionSection />

                <!-- Equipable -->
                <itemEditor:EquipableSection />

                <!-- Weapon -->
                <itemEditor:WeaponSection />

                <!-- Consumable -->
                <itemEditor:ConsumableSection />

                <!-- Collectable -->
                <itemEditor:CollectableSection />
                
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>