<UserControl
    x:Class="ItemTool.App.Views.LootBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:ItemTool.App.Views.Shared">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Loot table browser -->
        <Border
            Grid.Column="0"
            Padding="8"
            Background="#303030"
            BorderBrush="#555555"
            BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Loot Tables" />

                <ListBox
                    Grid.Row="1"
                    Background="#252525"
                    BorderBrush="#444444"
                    Foreground="#DADADA"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding LootTables}"
                    SelectedItem="{Binding SelectedListItem}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="{Binding Subtitle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter
            Grid.Column="1"
            Width="10"
            HorizontalAlignment="Stretch"
            Background="#222222" />

        <!-- Loot table editor -->
        <Border
            Grid.Column="2"
            Padding="12"
            Background="#303030"
            BorderBrush="#555555"
            BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <shared:ToolAssetHeader
                        Title="{Binding HeaderTitle}"
                        Subtitle="{Binding HeaderSubtitle}"
                        TechnicalInfo="{Binding HeaderTechnicalInfo}"
                        BadgeText="{Binding HeaderBadgeText}"
                        PreviewText="{Binding HeaderPreviewText}" />

                    <shared:ToolValidationBox
                        Title="Validation Summary"
                        BoxHeight="75"
                        Text="{Binding ValidationSummary}" />

                    <shared:ToolSection SectionTitle="General Information">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Text="{Binding SelectedLootTable.Id, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Text="{Binding SelectedLootTable.Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Random Picks" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Text="{Binding SelectedLootTable.MinRandomPicks, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Max Random Picks" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Text="{Binding SelectedLootTable.MaxRandomPicks, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </shared:ToolSection>

                    <shared:ToolSection SectionTitle="Entries">
                        <TextBlock
                            Opacity="0.75"
                            Text="Guaranteed and weighted entries will be implemented in the next step." />
                    </shared:ToolSection>

                    <shared:ToolSection SectionTitle="Simulation">
                        <TextBlock
                            Opacity="0.75"
                            Text="Loot simulation will be implemented after entries are editable." />
                    </shared:ToolSection>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>