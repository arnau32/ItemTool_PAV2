<UserControl
    x:Class="ItemTool.App.Views.LootBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="12"
        Background="#303030"
        BorderBrush="#555555"
        BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,8"
                FontSize="22"
                FontWeight="Bold"
                Text="{Binding PlaceholderTitle}" />

            <Border
                Grid.Row="1"
                Padding="16"
                Background="#252525"
                BorderBrush="#444444"
                BorderThickness="1">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="Loot Browser placeholder" />

                    <TextBlock
                        MaxWidth="520"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Text="{Binding PlaceholderDescription}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Opacity="0.75" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>