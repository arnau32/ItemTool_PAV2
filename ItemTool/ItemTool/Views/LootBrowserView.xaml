<UserControl
    x:Class="ItemTool.App.Views.LootBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lootEnums="clr-namespace:ItemTool.Domain.Enums;assembly=ItemTool.Domain"
    xmlns:shared="clr-namespace:ItemTool.App.Views.Shared"
    xmlns:validation="clr-namespace:ItemTool.Domain.Validation;assembly=ItemTool.Domain">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Loot table browser -->
        <Border
            Grid.Column="0"
            Padding="8"
            Background="#303030"
            BorderBrush="#555555"
            BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Loot Tables" />

                <ListBox
                    Grid.Row="1"
                    Background="#252525"
                    BorderBrush="#444444"
                    Foreground="#DADADA"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding LootTables}"
                    SelectedItem="{Binding SelectedListItem}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="{Binding Subtitle}" />
                                </StackPanel>

                                <!-- Severity badge: always right slot -->
                                <Border
                                    Grid.Column="1"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="9">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Setter Property="Background" Value="#666666" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}"
                                                             Value="{x:Static validation:ValidationSeverity.Warning}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="#D6A700" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Severity}"
                                                             Value="{x:Static validation:ValidationSeverity.Error}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="#C0392B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="!" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter
            Grid.Column="1"
            Width="10"
            HorizontalAlignment="Stretch"
            Background="#222222" />

        <!-- Loot table editor -->
        <Border
            Grid.Column="2"
            Padding="12"
            Background="#303030"
            BorderBrush="#555555"
            BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <shared:ToolAssetHeader
                        Title="{Binding HeaderTitle}"
                        Subtitle="{Binding HeaderSubtitle}"
                        TechnicalInfo="{Binding HeaderTechnicalInfo}"
                        BadgeText="{Binding HeaderBadgeText}"
                        PreviewText="{Binding HeaderPreviewText}" />

                    <shared:ToolValidationBox
                        Title="Validation Summary"
                        BoxHeight="75"
                        Text="{Binding ValidationSummary}" />

                    <shared:ToolSection SectionTitle="General Information">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Text="{Binding SelectedLootTable.Id, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Text="{Binding SelectedLootTable.Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Random Picks" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Text="{Binding SelectedLootTable.MinRandomPicks, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Max Random Picks" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                Text="{Binding SelectedLootTable.MaxRandomPicks, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </shared:ToolSection>

                    <shared:ToolSection SectionTitle="Guaranteed Entries">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Button Command="{Binding AddGuaranteedItemEntryCommand}" Content="+ Item" />
                                <Button Command="{Binding AddGuaranteedLootTableEntryCommand}" Content="+ Loot Table" />
                                <Button Command="{Binding ClearGuaranteedEntriesCommand}" Content="Clear" />
                            </StackPanel>

                            <Grid Margin="8,0,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Type"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Target Id"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Min Qty"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Max Qty"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Override Mode"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="5"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Rarity"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="6"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text=""
                                    TextAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SelectedLootTable.GuaranteedEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="8"
                                            Background="#252525"
                                            BorderBrush="#444444"
                                            BorderThickness="1">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ComboBox
                                                    Grid.Column="0"
                                                    Margin="0,0,6,0"
                                                    ItemsSource="{Binding DataContext.EntryTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedItem="{Binding EntryType, UpdateSourceTrigger=PropertyChanged}" />

                                                <Grid Grid.Column="1" Margin="0,0,6,0">
                                                    <ComboBox
                                                        IsEditable="True"
                                                        ItemsSource="{Binding DataContext.AvailableItemIds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedItem="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                                                        Text="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="Visibility" Value="Collapsed" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EntryType}"
                                                                            Value="{x:Static lootEnums:LootEntryType.Item}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>

                                                    <ComboBox
                                                        IsEditable="True"
                                                        ItemsSource="{Binding DataContext.AvailableLootTableIds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedItem="{Binding NestedLootTableId, UpdateSourceTrigger=PropertyChanged}"
                                                        Text="{Binding NestedLootTableId, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="Visibility" Value="Collapsed" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EntryType}"
                                                                            Value="{x:Static lootEnums:LootEntryType.LootTable}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                </Grid>

                                                <TextBox
                                                    Grid.Column="2"
                                                    Margin="0,0,6,0"
                                                    Text="{Binding MinQuantity, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBox
                                                    Grid.Column="3"
                                                    Margin="0,0,6,0"
                                                    Text="{Binding MaxQuantity, UpdateSourceTrigger=PropertyChanged}" />

                                                <ComboBox
                                                    Grid.Column="4"
                                                    Margin="0,0,6,0"
                                                    ItemsSource="{Binding DataContext.EquipableOverrideModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedItem="{Binding EquipableOverrideMode, UpdateSourceTrigger=PropertyChanged}" />

                                                <ComboBox
                                                    Grid.Column="5"
                                                    Margin="0,0,6,0"
                                                    ItemsSource="{Binding DataContext.ItemRarities, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedItem="{Binding OverrideFixedRarity, UpdateSourceTrigger=PropertyChanged}" />

                                                <Button
                                                    Grid.Column="6"
                                                    Command="{Binding DataContext.RemoveGuaranteedEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="X" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </shared:ToolSection>

                    <shared:ToolSection SectionTitle="Weighted Entries">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Button Command="{Binding AddWeightedItemEntryCommand}" Content="+ Item" />
                                <Button Command="{Binding AddWeightedLootTableEntryCommand}" Content="+ Loot Table" />
                                <Button Command="{Binding ClearWeightedEntriesCommand}" Content="Clear" />
                            </StackPanel>

                            <Grid Margin="8,0,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Type"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Target Id"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Min Qty"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Max Qty"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Weight"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="5"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Override Mode"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="6"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text="Rarity"
                                    TextAlignment="Center" />

                                <TextBlock
                                    Grid.Column="7"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Opacity="0.75"
                                    Text=""
                                    TextAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SelectedLootTable.WeightedEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="8"
                                            Background="#252525"
                                            BorderBrush="#444444"
                                            BorderThickness="1">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ComboBox
                                                    Grid.Column="0"
                                                    Margin="0,0,6,0"
                                                    ItemsSource="{Binding DataContext.EntryTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedItem="{Binding EntryType, UpdateSourceTrigger=PropertyChanged}" />

                                                <Grid Grid.Column="1" Margin="0,0,6,0">
                                                    <ComboBox
                                                        IsEditable="True"
                                                        ItemsSource="{Binding DataContext.AvailableItemIds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedItem="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                                                        Text="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="Visibility" Value="Collapsed" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EntryType}"
                                                                            Value="{x:Static lootEnums:LootEntryType.Item}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>

                                                    <ComboBox
                                                        IsEditable="True"
                                                        ItemsSource="{Binding DataContext.AvailableLootTableIds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedItem="{Binding NestedLootTableId, UpdateSourceTrigger=PropertyChanged}"
                                                        Text="{Binding NestedLootTableId, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox">
                                                                <Setter Property="Visibility" Value="Collapsed" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EntryType}"
                                                                            Value="{x:Static lootEnums:LootEntryType.LootTable}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                </Grid>

                                                <TextBox
                                                    Grid.Column="2"
                                                    Margin="0,0,6,0"
                                                    Text="{Binding MinQuantity, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBox
                                                    Grid.Column="3"
                                                    Margin="0,0,6,0"
                                                    Text="{Binding MaxQuantity, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBox
                                                    Grid.Column="4"
                                                    Margin="0,0,6,0"
                                                    Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" />

                                                <ComboBox
                                                    Grid.Column="5"
                                                    Margin="0,0,6,0"
                                                    ItemsSource="{Binding DataContext.EquipableOverrideModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedItem="{Binding EquipableOverrideMode, UpdateSourceTrigger=PropertyChanged}" />

                                                <ComboBox
                                                    Grid.Column="6"
                                                    Margin="0,0,6,0"
                                                    ItemsSource="{Binding DataContext.ItemRarities, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedItem="{Binding OverrideFixedRarity, UpdateSourceTrigger=PropertyChanged}" />

                                                <Button
                                                    Grid.Column="7"
                                                    Command="{Binding DataContext.RemoveWeightedEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="X" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </shared:ToolSection>

                    <shared:ToolSection SectionTitle="Simulation">
                        <TextBlock
                            Opacity="0.75"
                            Text="Loot simulation will be implemented after entries are editable." />
                    </shared:ToolSection>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>