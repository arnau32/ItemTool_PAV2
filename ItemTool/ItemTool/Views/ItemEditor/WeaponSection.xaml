<UserControl
    x:Class="ItemTool.App.Views.ItemEditor.WeaponSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:ItemTool.App.Views.Shared">

    <shared:ToolSection
        SectionTitle="Weapon"
        Visibility="{Binding ShowsWeaponSection, Converter={StaticResource BoolToVisibilityConverter}}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hand Type" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,8"
                ItemsSource="{Binding DataContext.WeaponHandTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding SelectedItem.Weapon.HandType, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Weapon Family" />
            <ComboBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,8"
                ItemsSource="{Binding DataContext.WeaponFamilies, RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding SelectedItem.Weapon.FamilyType, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Weapon Tier" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,0,8"
                Text="{Binding SelectedItem.Weapon.WeaponTier, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Enemy Damage Multiplier" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,0,0,8"
                Text="{Binding SelectedItem.Weapon.EnemyDamageMultiplier, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Skill Score Needed" />
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Margin="0,0,0,8"
                Text="{Binding SelectedItem.Weapon.SkillScoreNeeded, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Prefab Variant Path" />
            <TextBox
                Grid.Row="5"
                Grid.Column="1"
                Margin="0,0,0,8"
                Text="{Binding SelectedItem.Weapon.PrefabVariantPath, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
    </shared:ToolSection>
</UserControl>