<UserControl
    x:Class="ItemTool.App.Views.ItemEditor.CollectableSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:ItemTool.App.Views.Shared">

    <shared:ToolSection
        SectionTitle="Collectable"
        Visibility="{Binding ShowsCollectableSection, Converter={StaticResource BoolToVisibilityConverter}}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Collection ID" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,8"
                Text="{Binding SelectedItem.Collectable.CollectionId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Is Aurora Dust" />
            <CheckBox
                Grid.Row="1"
                Grid.Column="1"
                Foreground="#DADADA"
                IsChecked="{Binding SelectedItem.Collectable.IsAuroraDust, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
    </shared:ToolSection>
</UserControl>