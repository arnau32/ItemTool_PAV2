<UserControl
    x:Class="ItemTool.App.Views.Shared.ToolReadOnlyField"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="{Binding Label, ElementName=Root}" />

        <Border
            Grid.Column="1"
            Padding="4,2"
            Background="#1E1E1E"
            BorderBrush="#555555"
            BorderThickness="1">
            <TextBlock
                Margin="0"
                VerticalAlignment="Center"
                Text="{Binding Value, ElementName=Root}" />
        </Border>
    </Grid>
</UserControl>