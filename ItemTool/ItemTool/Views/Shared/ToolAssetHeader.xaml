<UserControl
    x:Class="ItemTool.App.Views.Shared.ToolAssetHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Margin="0,0,0,12"
        Padding="10"
        Background="#252525"
        BorderBrush="{Binding AccentBrush, ElementName=Root}"
        BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Preview placeholder -->
            <Border
                Grid.Column="0"
                Width="56"
                Height="56"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{Binding PreviewBackground, ElementName=Root}"
                BorderBrush="#666666"
                BorderThickness="1">

                <Grid>
                    <Image
                        Stretch="UniformToFill"
                        Source="{Binding PreviewImageSource, ElementName=Root}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImageSource, ElementName=Root}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Opacity="0.85"
                        Text="{Binding PreviewText, ElementName=Root}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImageSource, ElementName=Root}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock
                        Margin="0,0,0,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontSize="9"
                        Opacity="0.55"
                        Text="Preview" />
                </Grid>
            </Border>

            <!-- Main info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,2"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{Binding Title, ElementName=Root}" />

                <TextBlock
                    FontSize="12"
                    Opacity="0.75"
                    Text="{Binding Subtitle, ElementName=Root}" />

                <TextBlock
                    FontSize="11"
                    Opacity="0.55"
                    Text="{Binding TechnicalInfo, ElementName=Root}" />
            </StackPanel>

            <!-- Header actions -->
            <StackPanel
                Grid.Column="2"
                Margin="12,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">

                <Button
                    Margin="0,0,0,6"
                    HorizontalAlignment="Stretch"
                    Command="{Binding SaveCommand, ElementName=Root}"
                    Content="{Binding SaveButtonText, ElementName=Root}"
                    Visibility="{Binding SaveButtonVisibility, ElementName=Root}" />

                <Border
                    Padding="8,3"
                    HorizontalAlignment="Right"
                    Background="{Binding BadgeBackground, ElementName=Root}"
                    BorderBrush="#666666"
                    BorderThickness="1"
                    CornerRadius="3">

                    <TextBlock
                        Margin="0"
                        FontSize="11"
                        FontWeight="Bold"
                        Text="{Binding BadgeText, ElementName=Root}" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>