<UserControl
    x:Class="ItemTool.App.Views.Shared.ToolSection"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Expander
        Margin="0,0,0,12"
        Foreground="#DADADA"
        Header="{Binding SectionTitle, ElementName=Root}"
        IsExpanded="{Binding IsExpanded, ElementName=Root}">

        <Border
            Padding="10"
            Background="#303030"
            BorderBrush="#4A4A4A"
            BorderThickness="1">
            <ContentPresenter Content="{Binding SectionContent, ElementName=Root}" />
        </Border>
    </Expander>
</UserControl>