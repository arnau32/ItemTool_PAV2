<UserControl
    x:Class="ItemTool.App.Views.Shared.ToolDimensionPreview"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="10"
        Background="#252525"
        BorderBrush="#555555"
        BorderThickness="1">

        <StackPanel>
            <TextBlock
                x:Name="SizeLabel"
                Margin="0,0,0,8"
                FontSize="12"
                FontWeight="Bold"
                Opacity="0.85" />

            <Border
                Padding="8"
                HorizontalAlignment="Left"
                Background="#1E1E1E"
                BorderBrush="#444444"
                BorderThickness="1">

                <Grid x:Name="PreviewGrid" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>