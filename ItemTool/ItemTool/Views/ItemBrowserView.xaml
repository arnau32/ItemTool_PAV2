<UserControl
    x:Class="ItemTool.App.Views.ItemBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:ItemTool.App.Views.Shared"
    xmlns:validation="clr-namespace:ItemTool.Domain.Validation;assembly=ItemTool.Domain">

    <Border
        Padding="8"
        Background="#303030"
        BorderBrush="#555555"
        BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,8"
                FontSize="16"
                FontWeight="Bold"
                Text="Items" />

            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <shared:ToolFilterButton
                    Text="All"
                    Command="{Binding ShowAllItemsCommand}"
                    AccentBrush="{Binding AllFilterBrush}"
                    IsActive="{Binding IsAllFilterActive}" />

                <shared:ToolFilterButton
                    Text="Equipment"
                    Command="{Binding ShowEquipmentItemsCommand}"
                    AccentBrush="{Binding EquipmentFilterBrush}"
                    IsActive="{Binding IsEquipmentFilterActive}" />

                <shared:ToolFilterButton
                    Text="Weapon"
                    Command="{Binding ShowWeaponItemsCommand}"
                    AccentBrush="{Binding WeaponFilterBrush}"
                    IsActive="{Binding IsWeaponFilterActive}" />

                <shared:ToolFilterButton
                    Text="Consumable"
                    Command="{Binding ShowConsumableItemsCommand}"
                    AccentBrush="{Binding ConsumableFilterBrush}"
                    IsActive="{Binding IsConsumableFilterActive}" />

                <shared:ToolFilterButton
                    Text="Crafting"
                    Command="{Binding ShowCraftingItemsCommand}"
                    AccentBrush="{Binding CraftingFilterBrush}"
                    IsActive="{Binding IsCraftingFilterActive}" />

                <shared:ToolFilterButton
                    Text="Collectable"
                    Command="{Binding ShowCollectableItemsCommand}"
                    AccentBrush="{Binding CollectableFilterBrush}"
                    IsActive="{Binding IsCollectableFilterActive}" />
            </WrapPanel>

            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,8"
                FontSize="11"
                Opacity="0.75"
                Text="{Binding ActiveFilterText, StringFormat=Active filter: {0}}" />

            <ListBox
                Grid.Row="3"
                Background="#252525"
                BorderBrush="#444444"
                Foreground="#DADADA"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding FilteredItems}"
                SelectedItem="{Binding SelectedListItem}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>

                            <!-- Item kind color bar -->
                            <Border
                                Grid.Column="0"
                                Width="4"
                                Margin="0,0,8,0"
                                Background="{Binding KindBrush}" />

                            <!-- Main info -->
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.7"
                                    Text="{Binding Subtitle}" />
                            </StackPanel>

                            <!-- Rarity badge: before severity -->
                            <Border
                                Grid.Column="2"
                                Margin="8,0,6,0"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{Binding RarityBrush}"
                                CornerRadius="3">
                                <TextBlock
                                    Margin="0"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding RarityText}" />
                            </Border>

                            <!-- Severity badge: always right slot -->
                            <Border
                                Grid.Column="3"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                CornerRadius="9">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Setter Property="Background" Value="#666666" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}"
                                                         Value="{x:Static validation:ValidationSeverity.Warning}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Background" Value="#D6A700" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Severity}"
                                                         Value="{x:Static validation:ValidationSeverity.Error}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Background" Value="#C0392B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock
                                    Margin="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="!" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>