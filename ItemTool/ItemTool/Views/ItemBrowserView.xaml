<UserControl
    x:Class="ItemTool.App.Views.ItemBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="8"
        Background="#303030"
        BorderBrush="#555555"
        BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,8"
                FontSize="16"
                FontWeight="Bold"
                Text="Items" />

            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <Button Command="{Binding ShowAllItemsCommand}" Content="All" />
                <Button Command="{Binding ShowEquipmentItemsCommand}" Content="Equipment" />
                <Button Command="{Binding ShowWeaponItemsCommand}" Content="Weapon" />
                <Button Command="{Binding ShowConsumableItemsCommand}" Content="Consumable" />
                <Button Command="{Binding ShowCraftingItemsCommand}" Content="Crafting" />
                <Button Command="{Binding ShowCollectableItemsCommand}" Content="Collectable" />
            </WrapPanel>

            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,8"
                FontSize="11"
                Opacity="0.75"
                Text="{Binding ActiveFilterText, StringFormat=Active filter: {0}}" />

            <ListBox
                Grid.Row="3"
                Background="#252525"
                BorderBrush="#444444"
                Foreground="#DADADA"
                ItemsSource="{Binding FilteredItems}"
                SelectedItem="{Binding SelectedListItem}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.7"
                                    Text="{Binding Subtitle}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Severity}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>