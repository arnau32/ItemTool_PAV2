<UserControl
    x:Class="ItemTool.App.Views.Loot.LootEntryHeaderRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8,0,8,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="{Binding WeightColumnWidth, ElementName=Root}" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Opacity="0.75" Text="Type" TextAlignment="Center" />
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Opacity="0.75" Text="Target Id" TextAlignment="Center" />
        <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Opacity="0.75" Text="Min Qty" TextAlignment="Center" />
        <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Opacity="0.75" Text="Max Qty" TextAlignment="Center" />
        <TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Opacity="0.75" Text="Weight" TextAlignment="Center" />
        <TextBlock Grid.Column="5" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Opacity="0.75" Text="Override Mode" TextAlignment="Center" />
        <TextBlock Grid.Column="6" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Opacity="0.75" Text="Rarity" TextAlignment="Center" />
        <TextBlock Grid.Column="7" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Opacity="0.75" Text="" TextAlignment="Center" />
    </Grid>
</UserControl>