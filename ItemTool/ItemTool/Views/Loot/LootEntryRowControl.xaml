<UserControl
    x:Class="ItemTool.App.Views.Loot.LootEntryRowControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lootEnums="clr-namespace:ItemTool.Domain.Enums;assembly=ItemTool.Domain">

    <Border
        Margin="0,0,0,6"
        Padding="8"
        Background="#252525"
        BorderBrush="#444444"
        BorderThickness="1">

        <Grid DataContext="{Binding Entry, ElementName=Root}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="{Binding WeightColumnWidth, ElementName=Root}" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                Grid.Column="0"
                Margin="0,0,6,0"
                ItemsSource="{Binding EntryTypes, ElementName=Root}"
                SelectedItem="{Binding EntryType, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Column="1" Margin="0,0,6,0">
                <ComboBox
                    IsEditable="True"
                    ItemsSource="{Binding AvailableItemIds, ElementName=Root}"
                    SelectedItem="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}"
                    Text="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EntryType}" Value="{x:Static lootEnums:LootEntryType.Item}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <ComboBox
                    IsEditable="True"
                    ItemsSource="{Binding AvailableLootTableIds, ElementName=Root}"
                    SelectedItem="{Binding NestedLootTableId, UpdateSourceTrigger=PropertyChanged}"
                    Text="{Binding NestedLootTableId, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EntryType}" Value="{x:Static lootEnums:LootEntryType.LootTable}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </Grid>

            <TextBox
                Grid.Column="2"
                Margin="0,0,6,0"
                Text="{Binding MinQuantity, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                Grid.Column="3"
                Margin="0,0,6,0"
                Text="{Binding MaxQuantity, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                Grid.Column="4"
                Margin="0,0,6,0"
                Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                Grid.Column="5"
                Margin="0,0,6,0"
                ItemsSource="{Binding EquipableOverrideModes, ElementName=Root}"
                SelectedItem="{Binding EquipableOverrideMode, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                Grid.Column="6"
                Margin="0,0,6,0"
                ItemsSource="{Binding ItemRarities, ElementName=Root}"
                SelectedItem="{Binding OverrideFixedRarity, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Grid.Column="7"
                Command="{Binding RemoveCommand, ElementName=Root}"
                CommandParameter="{Binding Entry, ElementName=Root}"
                Content="X" />
        </Grid>
    </Border>
</UserControl>