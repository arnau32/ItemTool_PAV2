<Window
    x:Class="ItemTool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Item Browser"
    Width="1400"
    Height="850"
    Background="#2B2B2B"
    Foreground="#DADADA"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DADADA" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A4A4A" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#DADADA" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding LoadCommand}" Content="Load" />
                <Button Command="{Binding SaveCommand}" Content="Save" />
                <Button Command="{Binding RefreshValidationCommand}" Content="Validate" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding NewEquipmentItemCommand}" Content="+ Equipment" />
                <Button Command="{Binding NewWeaponItemCommand}" Content="+ Weapon" />
                <Button Command="{Binding NewConsumableItemCommand}" Content="+ Consumable" />
                <Button Command="{Binding NewCraftingItemCommand}" Content="+ Crafting" />
                <Button Command="{Binding NewCollectableItemCommand}" Content="+ Collectable" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Browser -->
            <Border
                Grid.Column="0"
                Padding="8"
                Background="#303030"
                BorderBrush="#555555"
                BorderThickness="1">
<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock
        Margin="0,0,0,8"
        FontSize="16"
        FontWeight="Bold"
        Text="Items" />

    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
        <Button Command="{Binding ShowAllItemsCommand}" Content="All" />
        <Button Command="{Binding ShowEquipmentItemsCommand}" Content="Equipment" />
        <Button Command="{Binding ShowWeaponItemsCommand}" Content="Weapon" />
        <Button Command="{Binding ShowConsumableItemsCommand}" Content="Consumable" />
        <Button Command="{Binding ShowCraftingItemsCommand}" Content="Crafting" />
        <Button Command="{Binding ShowCollectableItemsCommand}" Content="Collectable" />
    </WrapPanel>

    <TextBlock
        Grid.Row="2"
        Margin="0,0,0,8"
        FontSize="11"
        Opacity="0.75"
        Text="{Binding ActiveFilterText, StringFormat=Active filter: {0}}" />

    <ListBox
        Grid.Row="3"
        Background="#252525"
        BorderBrush="#444444"
        Foreground="#DADADA"
        ItemsSource="{Binding FilteredItems}"
        SelectedItem="{Binding SelectedListItem}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                        <TextBlock
                            FontSize="11"
                            Opacity="0.7"
                            Text="{Binding Subtitle}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Severity}" />
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="10"
                HorizontalAlignment="Stretch"
                Background="#222222" />

            <!-- Editor -->
            <Border
                Grid.Column="2"
                Padding="12"
                Background="#303030"
                BorderBrush="#555555"
                BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Editor}">

                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="22"
                            FontWeight="Bold"
                            Text="Item Editor" />

                        <!-- Validation -->
                        <GroupBox Header="Validation Summary">
                            <TextBox
                                Height="75"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                Text="{Binding DataContext.ValidationSummary, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextWrapping="Wrap" />
                        </GroupBox>

                        <!-- Preview -->
                        <GroupBox Header="Dimensions Preview">
                            <TextBox
                                Height="110"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                IsReadOnly="True"
                                Text="{Binding DataContext.DimensionPreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextWrapping="NoWrap" />
                        </GroupBox>

                        <!-- General -->
                        <GroupBox Header="General Information">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Kind" />
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Padding="4,2"
                                    Background="#1E1E1E"
                                    BorderBrush="#555555"
                                    BorderThickness="1">
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding ItemKindText}" />
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Unity Item Type" />
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Padding="4,2"
                                    Background="#1E1E1E"
                                    BorderBrush="#555555"
                                    BorderThickness="1">
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding ItemTypeText}" />
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Id" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.Id, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Item Name ID" />
                                <TextBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.ItemNameId, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Display Name" />
                                <TextBox
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Description" />
                                <TextBox
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Height="80"
                                    Margin="0,0,0,8"
                                    AcceptsReturn="True"
                                    Text="{Binding SelectedItem.Description, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Icon Path" />
                                <TextBox
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.IconPath, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Rarity" />
                                <ComboBox
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    ItemsSource="{Binding DataContext.ItemRarities, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedItem="{Binding SelectedItem.ItemRarity, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Value" />
                                <TextBox
                                    Grid.Row="8"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.Value, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Weight" />
                                <TextBox
                                    Grid.Row="9"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.Weight, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <!-- Dimensions -->
                        <GroupBox Header="Slot Dimension">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Stack" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.MaxStack, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Width" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.SlotDimension.Width, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Height" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.SlotDimension.Height, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <!-- Equipable -->
                        <GroupBox
                            Header="Equipable"
                            Visibility="{Binding ShowsEquipableSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Opacity="0.75"
                                    Text="FixedRarityFixedStats usa stats base. FixedRarityRandomStats aplica rarity fija y stats aleatorios. RandomRarityRandomStats aleatoriza rarity y stats." />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Roll Mode" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        ItemsSource="{Binding DataContext.EquipableRollModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                        SelectedItem="{Binding SelectedItem.Equipable.RollMode, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Equip Slot" />
                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        ItemsSource="{Binding DataContext.EquipSlots, RelativeSource={RelativeSource AncestorType=Window}}"
                                        SelectedItem="{Binding SelectedItem.Equipable.EquipSlot, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tier" />
                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Text="{Binding SelectedItem.Equipable.Tier, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Prefab Path" />
                                    <TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Text="{Binding SelectedItem.Equipable.PrefabPath, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <StackPanel Margin="0,8,0,6" Orientation="Horizontal">
                                    <Button Command="{Binding AddStatModifierCommand}" Content="+ Add Modifier" />
                                    <Button Command="{Binding ClearStatModifiersCommand}" Content="Clear" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding SelectedItem.Equipable.Modifiers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>

                                                <ComboBox
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    ItemsSource="{Binding DataContext.StatTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    SelectedItem="{Binding StatType, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBox
                                                    Grid.Column="1"
                                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <!-- Weapon -->
                        <GroupBox
                            Header="Weapon"
                            Visibility="{Binding ShowsWeaponSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hand Type" />
                                <ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    ItemsSource="{Binding DataContext.WeaponHandTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedItem="{Binding SelectedItem.Weapon.HandType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Weapon Family" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    ItemsSource="{Binding DataContext.WeaponFamilies, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedItem="{Binding SelectedItem.Weapon.FamilyType, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Weapon Tier" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.Weapon.WeaponTier, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Enemy Damage Multiplier" />
                                <TextBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.Weapon.EnemyDamageMultiplier, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Skill Score Needed" />
                                <TextBox
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.Weapon.SkillScoreNeeded, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Prefab Variant Path" />
                                <TextBox
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.Weapon.PrefabVariantPath, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <!-- Consumable -->
                        <GroupBox
                            Header="Consumable"
                            Visibility="{Binding ShowsConsumableSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                    <Button Command="{Binding AddBuffCommand}" Content="+ Add Buff" />
                                    <Button Command="{Binding ClearBuffsCommand}" Content="Clear" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding SelectedItem.Consumable.Buffs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>

                                                <ComboBox
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    ItemsSource="{Binding DataContext.BuffApplicationModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    SelectedItem="{Binding ApplicationMode, UpdateSourceTrigger=PropertyChanged}" />

                                                <ComboBox
                                                    Grid.Column="1"
                                                    Margin="0,0,8,0"
                                                    ItemsSource="{Binding DataContext.StatTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    SelectedItem="{Binding StatType, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBox
                                                    Grid.Column="2"
                                                    Margin="0,0,8,0"
                                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBox
                                                    Grid.Column="3"
                                                    Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <!-- Collectable -->
                        <GroupBox
                            Header="Collectable"
                            Visibility="{Binding ShowsCollectableSection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Collection ID" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Text="{Binding SelectedItem.Collectable.CollectionId, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Is Aurora Dust" />
                                <CheckBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Foreground="#DADADA"
                                    IsChecked="{Binding SelectedItem.Collectable.IsAuroraDust, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>