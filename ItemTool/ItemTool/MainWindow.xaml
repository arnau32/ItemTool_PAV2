<Window
    x:Class="ItemTool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:ItemTool.App.Views"
    Title="Item Browser"
    Width="1400"
    Height="850"
    Background="#2B2B2B"
    Foreground="#DADADA"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding LoadCommand}" Content="Load" />
                <Button Command="{Binding SaveCommand}" Content="Save" />
                <Button Command="{Binding RefreshValidationCommand}" Content="Validate" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding NewEquipmentItemCommand}" Content="+ Equipment" />
                <Button Command="{Binding NewWeaponItemCommand}" Content="+ Weapon" />
                <Button Command="{Binding NewConsumableItemCommand}" Content="+ Consumable" />
                <Button Command="{Binding NewCraftingItemCommand}" Content="+ Crafting" />
                <Button Command="{Binding NewCollectableItemCommand}" Content="+ Collectable" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:ItemBrowserView Grid.Column="0" />

            <GridSplitter
                Grid.Column="1"
                Width="10"
                HorizontalAlignment="Stretch"
                Background="#222222" />

            <views:ItemEditorView Grid.Column="2" />
        </Grid>
    </Grid>
</Window>