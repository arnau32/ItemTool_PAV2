<Window
    x:Class="ItemTool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:ItemTool.App.Views"
    Title="Item Tool"
    Width="1400"
    Height="850"
    Background="#2B2B2B"
    Foreground="#DADADA"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Workspace tabs -->
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button
                    Command="{Binding ShowItemsWorkspaceCommand}"
                    Content="Items" />

                <Button
                    Command="{Binding ShowLootTablesWorkspaceCommand}"
                    Content="Loot Tables" />
            </StackPanel>
        </DockPanel>

        <!-- Items toolbar -->
        <DockPanel
            Grid.Row="1"
            Margin="0,0,0,8"
            Visibility="{Binding IsItemsWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">

            <DockPanel DataContext="{Binding Items}">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Command="{Binding LoadCommand}" Content="Load" />
                    <Button Command="{Binding SaveCommand}" Content="Save" />
                    <Button Command="{Binding RefreshValidationCommand}" Content="Validate" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding NewEquipmentItemCommand}" Content="+ Equipment" />
                    <Button Command="{Binding NewWeaponItemCommand}" Content="+ Weapon" />
                    <Button Command="{Binding NewConsumableItemCommand}" Content="+ Consumable" />
                    <Button Command="{Binding NewCraftingItemCommand}" Content="+ Crafting" />
                    <Button Command="{Binding NewCollectableItemCommand}" Content="+ Collectable" />
                </StackPanel>
            </DockPanel>
        </DockPanel>

        <!-- Loot toolbar -->
        <DockPanel
            Grid.Row="1"
            Margin="0,0,0,8"
            Visibility="{Binding IsLootTablesWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">

            <DockPanel DataContext="{Binding LootTables}">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Command="{Binding LoadCommand}" Content="Load" />
                    <Button Command="{Binding SaveCommand}" Content="Save" />
                    <Button Command="{Binding RefreshValidationCommand}" Content="Validate" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding NewLootTableCommand}" Content="+ Loot Table" />
                </StackPanel>
            </DockPanel>
        </DockPanel>

        <!-- Items workspace -->
        <Grid
            Grid.Row="2"
            Visibility="{Binding IsItemsWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid DataContext="{Binding Items}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:ItemBrowserView Grid.Column="0" />

                <GridSplitter
                    Grid.Column="1"
                    Width="10"
                    HorizontalAlignment="Stretch"
                    Background="#222222" />

                <views:ItemEditorView Grid.Column="2" />
            </Grid>
        </Grid>

        <!-- Loot workspace -->
        <Grid
            Grid.Row="2"
            Visibility="{Binding IsLootTablesWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">

            <views:LootBrowserView DataContext="{Binding LootTables}" />
        </Grid>
    </Grid>
</Window>