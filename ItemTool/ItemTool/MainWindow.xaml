<Window
    x:Class="ItemTool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:ItemTool.App.Views"
    Title="Item Tool"
    Width="1400"
    Height="850"
    Background="#2B2B2B"
    Foreground="#DADADA"
    Loaded="Window_Loaded"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Workspace tabs -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Height="30"
                Margin="0,0,4,0"
                Command="{Binding ShowItemsWorkspaceCommand}"
                Content="Items" />

            <Button
                Grid.Column="1"
                Height="30"
                Margin="4,0,0,0"
                Command="{Binding ShowLootTablesWorkspaceCommand}"
                Content="Loot Tables" />
        </Grid>

        <!-- Unity project settings -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="8"
            Background="#252525"
            BorderBrush="#444444"
            BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Unity Project" />

                <StackPanel Grid.Column="1">
                    <TextBox
                        Margin="0,0,8,2"
                        Text="{Binding UnityProjectRootPath, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        FontSize="11"
                        Opacity="0.7"
                        Text="{Binding ProjectSettingsStatusText}" />

                    <TextBlock
                        FontSize="11"
                        Opacity="0.7"
                        Text="{Binding UnityContentOperationStatusText}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Command="{Binding BrowseUnityProjectRootCommand}"
                    Content="Browse..." />

                <Button
                    Grid.Column="3"
                    VerticalAlignment="Top"
                    Command="{Binding SaveProjectSettingsCommand}"
                    Content="Save Config" />

                <Button
                    Grid.Column="4"
                    VerticalAlignment="Top"
                    Command="{Binding ImportUnityContentCommand}"
                    Content="Import" />

                <Button
                    Grid.Column="5"
                    VerticalAlignment="Top"
                    Command="{Binding ExportUnityContentCommand}"
                    Content="Export" />
            </Grid>
        </Border>

        <!-- Items toolbar -->
        <DockPanel
            Grid.Row="2"
            Margin="0,0,0,8"
            Visibility="{Binding IsItemsWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid DataContext="{Binding Items}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding NewEquipmentItemCommand}" Content="+ Equipment" />
                    <Button Command="{Binding NewWeaponItemCommand}" Content="+ Weapon" />
                    <Button Command="{Binding NewConsumableItemCommand}" Content="+ Consumable" />
                    <Button Command="{Binding NewCraftingItemCommand}" Content="+ Crafting" />
                    <Button Command="{Binding NewCollectableItemCommand}" Content="+ Collectable" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button Command="{Binding LoadCommand}" Content="Load" />
                    <Button Command="{Binding SaveCommand}" Content="Save All" />
                    <Button Command="{Binding RefreshValidationCommand}" Content="Validate" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Loot toolbar -->
        <DockPanel
            Grid.Row="2"
            Margin="0,0,0,8"
            Visibility="{Binding IsLootTablesWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid DataContext="{Binding LootTables}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding NewLootTableCommand}" Content="+ Loot Table" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button Command="{Binding LoadCommand}" Content="Load" />
                    <Button Command="{Binding SaveCommand}" Content="Save All" />
                    <Button Command="{Binding RefreshValidationCommand}" Content="Validate" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Items workspace -->
        <Grid
            Grid.Row="3"
            Visibility="{Binding IsItemsWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid DataContext="{Binding Items}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:ItemBrowserView Grid.Column="0" />

                <GridSplitter
                    Grid.Column="1"
                    Width="10"
                    HorizontalAlignment="Stretch"
                    Background="#222222" />

                <views:ItemEditorView Grid.Column="2" />
            </Grid>
        </Grid>

        <!-- Loot workspace -->
        <Grid
            Grid.Row="3"
            Visibility="{Binding IsLootTablesWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">

            <views:LootBrowserView DataContext="{Binding LootTables}" />
        </Grid>
    </Grid>
</Window>