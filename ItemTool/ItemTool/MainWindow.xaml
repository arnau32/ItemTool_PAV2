<Window
    x:Class="ItemTool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Item Browser"
    Width="1300"
    Height="800"
    mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Command="{Binding LoadCommand}"
                Content="Load" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding SaveCommand}"
                Content="Save" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding NewItemCommand}"
                Content="New" />
            <Button Command="{Binding RefreshValidationCommand}" Content="Validate" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="8"
                BorderBrush="Gray"
                BorderThickness="1">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                    <TextBlock Opacity="0.7" Text="{Binding Type}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Severity}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="10"
                HorizontalAlignment="Stretch" />

            <Border
                Grid.Column="2"
                Padding="12"
                BorderBrush="Gray"
                BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Editor}">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="Item Editor" />

                        <TextBlock FontWeight="Bold" Text="Validation Summary" />
                        <TextBox
                            Height="80"
                            Margin="0,0,0,12"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            Text="{Binding DataContext.ValidationSummary, RelativeSource={RelativeSource AncestorType=Window}}"
                            TextWrapping="Wrap" />

                        <TextBlock FontWeight="Bold" Text="Dimensions Preview" />
                        <TextBox
                            Height="120"
                            Margin="0,0,0,12"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            Text="{Binding DataContext.DimensionPreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                            TextWrapping="NoWrap" />

                        <TextBlock Text="Id" />
                        <TextBox Margin="0,0,0,8" Text="{Binding SelectedItem.Id, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Item Type" />
                        <ComboBox
                            Margin="0,0,0,8"
                            ItemsSource="{Binding DataContext.ItemTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                            SelectedItem="{Binding SelectedItem.ItemType, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Name" />
                        <TextBox Margin="0,0,0,8" Text="{Binding SelectedItem.ItemName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Description" />
                        <TextBox
                            Height="100"
                            Margin="0,0,0,8"
                            AcceptsReturn="True"
                            Text="{Binding SelectedItem.Description, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Icon Path" />
                        <TextBox Margin="0,0,0,8" Text="{Binding SelectedItem.IconPath, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Rarity" />
                        <ComboBox
                            Margin="0,0,0,8"
                            ItemsSource="{Binding DataContext.ItemRarities, RelativeSource={RelativeSource AncestorType=Window}}"
                            SelectedItem="{Binding SelectedItem.ItemRarity, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Value" />
                        <TextBox Margin="0,0,0,8" Text="{Binding SelectedItem.Value, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Weight" />
                        <TextBox Margin="0,0,0,8" Text="{Binding SelectedItem.Weight, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Max Stack" />
                        <TextBox Margin="0,0,0,8" Text="{Binding SelectedItem.MaxStack, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Width" />
                        <TextBox Margin="0,0,0,8" Text="{Binding SelectedItem.SlotDimension.Width, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Height" />
                        <TextBox Margin="0,0,0,8" Text="{Binding SelectedItem.SlotDimension.Height, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>