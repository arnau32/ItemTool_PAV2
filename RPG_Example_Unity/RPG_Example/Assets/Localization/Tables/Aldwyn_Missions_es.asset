%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Aldwyn_Missions_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: e94557620545797449b61a903d40f81c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 100000000000
    m_Localized: "Aldwyn\u2026 eso es todo lo que me queda"
    m_Metadata:
      m_Items: []
  - m_Id: 200000000000
    m_Localized: "La niebla lleg\xF3, y solo las ascuas de Aurora la mantiene fuera\u2026
      pero se apaga."
    m_Metadata:
      m_Items: []
  - m_Id: 300000000000
    m_Localized: "Si a\xFAn confundes suerte con valor, sal por la puerta del norte
      y busca lo que los antiguos llaman Polvo de Aurora, con ello, recuperaremos
      el fuego."
    m_Metadata:
      m_Items: []
  - m_Id: 400000000000
    m_Localized: "Varrik te abrir\xE1 la puerta. Solo el Polvo de Aurora decidir\xE1
      si queda un hogar al que volver."
    m_Metadata:
      m_Items: []
  - m_Id: 500000000000
    m_Localized: Yo ya no puedo cruzarla. No me queda nada que la niebla no pueda
      reclamar.
    m_Metadata:
      m_Items: []
  - m_Id: 600000000000
    m_Localized: Si quieres ayudar a este pueblo, o lo que queda de el... Traeme
      50 polvos aurora
    m_Metadata:
      m_Items: []
  - m_Id: 700000000000
    m_Localized: "Toma la salida del norte, es la \xFAnica que queda en pie."
    m_Metadata:
      m_Items: []
  - m_Id: 800000000000
    m_Localized: Si lo encuentras... traelo.
    m_Metadata:
      m_Items: []
  - m_Id: 900000000000
    m_Localized: Sin la llama no duraremos mucho.
    m_Metadata:
      m_Items: []
  - m_Id: 1000000000000
    m_Localized: Solo el Polvo de Aurora puede mantenerla viva.
    m_Metadata:
      m_Items: []
  - m_Id: 1100000000000
    m_Localized: "Pero salir ah\xED fuera... es una sentencia de muerte."
    m_Metadata:
      m_Items: []
  - m_Id: 1200000000000
    m_Localized: "Para cualquiera que no seas t\xFA, parece."
    m_Metadata:
      m_Items: []
  - m_Id: 1300000000000
    m_Localized: Necesito cincuenta polvos Aurora.
    m_Metadata:
      m_Items: []
  - m_Id: 1400000000000
    m_Localized: "Si de verdad la Niebla te reh\xFAye... quiz\xE1 seas nuestra \xFAnica
      oportunidad."
    m_Metadata:
      m_Items: []
  - m_Id: 1500000000000
    m_Localized: Un herrero.
    m_Metadata:
      m_Items: []
  - m_Id: 1600000000000
    m_Localized: "Hac\xEDa a\xF1os que no ve\xEDa uno por aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1700000000000
    m_Localized: "...Algo en \xE9l no cuadra. Pero la forja no miente."
    m_Metadata:
      m_Items: []
  - m_Id: 1800000000000
    m_Localized: "Esas alas no las rompi\xF3 la Niebla."
    m_Metadata:
      m_Items: []
  - m_Id: 1900000000000
    m_Localized: "Las rompi\xF3 algo peor. La p\xE9rdida."
    m_Metadata:
      m_Items: []
  - m_Id: 2000000000000
    m_Localized: No la presiones. Sabe muy bien lo que ha perdido.
    m_Metadata:
      m_Items: []
  - m_Id: 2100000000000
    m_Localized: Traer a un consumido dentro del refugio...
    m_Metadata:
      m_Items: []
  - m_Id: 2200000000000
    m_Localized: "Si pierde el control, ninguno de nosotros podr\xE1 frenarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 2300000000000
    m_Localized: "Pero lo que queda de \xE9l todav\xEDa lucha. No muchos llegan tan
      lejos."
    m_Metadata:
      m_Items: []
  - m_Id: 2400000000000
    m_Localized: "...El fuego parece m\xE1s grande esta noche."
    m_Metadata:
      m_Items: []
  - m_Id: 2500000000000
    m_Localized: "\u2026No pens\xE9 que lo lograr\xEDas."
    m_Metadata:
      m_Items: []
  - m_Id: 2600000000000
    m_Localized: "El Polvo de Aurora\u2026 a\xFAn conserva la memoria de la luz. "
    m_Metadata:
      m_Items: []
  - m_Id: 2700000000000
    m_Localized: "\xDAsalo en la hoguera\u2026 antes de que la niebla nos consuma."
    m_Metadata:
      m_Items: []
  - m_Id: 2800000000000
    m_Localized: "No pens\xE9 que volver\xEDa a ver esto arder. "
    m_Metadata:
      m_Items: []
  - m_Id: 2900000000000
    m_Localized: "\u2026Quiz\xE1 todav\xEDa queda algo que salvar."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000
    m_Localized: "\u2026y su llama no solo alumbrar\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 3100000000000
    m_Localized: "El puente del noroeste, dentro de la aldea\u2026 cay\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 3200000000000
    m_Localized: Era el paso hacia la iglesia.
    m_Metadata:
      m_Items: []
  - m_Id: 3300000000000
    m_Localized: "Si pudieras devolverle el paso\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3400000000000
    m_Localized: "La iglesia a\xFAn podr\xEDa servir para sanar."
    m_Metadata:
      m_Items: []
  - m_Id: 3500000000000
    m_Localized: "Yo ya lo intent\xE9... hace a\xF1os."
    m_Metadata:
      m_Items: []
  - m_Id: 3600000000000
    m_Localized: "No s\xE9 por que confio. Si ya s\xE9 c\xF3mo termina esto."
    m_Metadata:
      m_Items: []
  - m_Id: 3700000000000
    m_Localized: Lo intentamos reparar en su momento, pero todo lo que la niebla
      toca, se pudre.
    m_Metadata:
      m_Items: []
  - m_Id: 3800000000000
    m_Localized: "Si traes m\xE1s polvo Aurora la hoguera, aumentaras el poder de
      la luz."
    m_Metadata:
      m_Items: []
  - m_Id: 3900000000000
    m_Localized: El viento...
    m_Metadata:
      m_Items: []
  - m_Id: 4000000000000
    m_Localized: "Hace a\xF1os que no lo sent\xEDa as\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 4100000000000
    m_Localized: "Es d\xE9bil. Apenas un susurro."
    m_Metadata:
      m_Items: []
  - m_Id: 4200000000000
    m_Localized: "Pero est\xE1 ah\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 4300000000000
    m_Localized: "El Santuario de Liora se pudre en el mismo silencio desde que mis
      pies profanaron este suelo. Es un cad\xE1ver de piedra que se niega a descansar."
    m_Metadata:
      m_Items: []
  - m_Id: 4400000000000
    m_Localized: "Ya no queda en ella el poder\u2026 ni la fe que una vez tuvo."
    m_Metadata:
      m_Items: []
  - m_Id: 4500000000000
    m_Localized: "Antes hab\xEDa muchas iglesias."
    m_Metadata:
      m_Items: []
  - m_Id: 4600000000000
    m_Localized: Cada una con su propia imagen.
    m_Metadata:
      m_Items: []
  - m_Id: 4700000000000
    m_Localized: "Si alguna de ellas a\xFAn sigue en pie\u2026 trae sus estatuas
      de vuelta."
    m_Metadata:
      m_Items: []
  - m_Id: 4800000000000
    m_Localized: "Quiz\xE1 esta recupere parte de su fuerza."
    m_Metadata:
      m_Items: []
  - m_Id: 4900000000000
    m_Localized: Noto algo en el aire. Diferente.
    m_Metadata:
      m_Items: []
  - m_Id: 5000000000000
    m_Localized: "La \xFAltima vez que sent\xED esto todav\xEDa hab\xEDa otros monjes
      aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 5100000000000
    m_Localized: "Date prisa. No s\xE9 cu\xE1nto dura."
    m_Metadata:
      m_Items: []
  - m_Id: 5200000000000
    m_Localized: Lo presiento, el viento vuelve a moverse entre ellos.
    m_Metadata:
      m_Items: []
  - m_Id: 5300000000000
    m_Localized: "No con la fuerza del pasado, pero mucho m\xE1s de lo que esperaba
      volver a vivir."
    m_Metadata:
      m_Items: []
  - m_Id: 5400000000000
    m_Localized: " Si a\xFAn quedan iglesias abandonadas\u2026 trae sus estatuas.
      Tal vez entonces\u2026 Liora responda."
    m_Metadata:
      m_Items: []
  - m_Id: 5500000000000
    m_Localized: "Toma\u2026 es poco, pero es todo lo que puedo darte."
    m_Metadata:
      m_Items: []
  - m_Id: 5600000000000
    m_Localized: "Esto... no viene de aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 5700000000000
    m_Localized: "El viento tiene direcci\xF3n. Intenci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 5800000000000
    m_Localized: "Hay algo m\xE1s antiguo..."
    m_Metadata:
      m_Items: []
  - m_Id: 5900000000000
    m_Localized: El primer santuario. El origen de todo esto.
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000
    m_Localized: "Nunca lo busqu\xE9. No cre\xEDa que quedara nada."
    m_Metadata:
      m_Items: []
  - m_Id: 6100000000000
    m_Localized: ...Puede que me equivocara.
    m_Metadata:
      m_Items: []
  - m_Id: 6200000000000
    m_Localized: "No s\xE9 si existe realmente. Puede que sea solo un eco de lo que
      quiero creer."
    m_Metadata:
      m_Items: []
  - m_Id: 6300000000000
    m_Localized: "Llevo a\xF1os dici\xE9ndome que no queda nada. Y ahora..."
    m_Metadata:
      m_Items: []
  - m_Id: 6400000000000
    m_Localized: Vuelve. Sea lo que sea lo que encuentres, vuelve.
    m_Metadata:
      m_Items: []
  - m_Id: 6500000000000
    m_Localized: ...Lo encontraste.
    m_Metadata:
      m_Items: []
  - m_Id: 6600000000000
    m_Localized: "Todo este tiempo pens\xE9 que era demasiado tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 6700000000000
    m_Localized: Que no quedaba nada por sentir.
    m_Metadata:
      m_Items: []
  - m_Id: 6800000000000
    m_Localized: "...Quiz\xE1s no lo era."
    m_Metadata:
      m_Items: []
  - m_Id: 6900000000000
    m_Localized: "\xBFQu\xE9 necesitas?"
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000
    m_Localized: "Sigues aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 7100000000000
    m_Localized: "...\xBFAlgo va mal?"
    m_Metadata:
      m_Items: []
  - m_Id: 7200000000000
    m_Localized: "La Niebla estuvo cerca anoche. M\xE1s que de costumbre."
    m_Metadata:
      m_Items: []
  - m_Id: 7300000000000
    m_Localized: "Hay un rinc\xF3n del bosque donde el viento todav\xEDa suena como
      antes. No entres en \xE9l."
    m_Metadata:
      m_Items: []
  - m_Id: 7400000000000
    m_Localized: "Antes hab\xEDa un mercado aqu\xED. El octavo d\xEDa de la semana."
    m_Metadata:
      m_Items: []
  - m_Id: 7500000000000
    m_Localized: "No s\xE9 cu\xE1nto tiempo llevas despierta. Pero yo llevo as\xED
      cuatro a\xF1os."
    m_Metadata:
      m_Items: []
  - m_Id: 7600000000000
    m_Localized: "\xBFC\xF3mo est\xE1 el exterior? ...No. Mejor no me lo cuentes."
    m_Metadata:
      m_Items: []
  - m_Id: 7700000000000
    m_Localized: "Hay algo en lo que podr\xEDas ayudar. Si quieres escucharlo."
    m_Metadata:
      m_Items: []
  - m_Id: 7800000000000
    m_Localized: "...Tengo un favor que pedirte. Cuando est\xE9s lista."
    m_Metadata:
      m_Items: []
  - m_Id: 7900000000000
    m_Localized: "\xBFYa has vuelto? Todav\xEDa falta."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000
    m_Localized: No hay prisa. Pero tampoco hay tiempo que perder.
    m_Metadata:
      m_Items: []
  - m_Id: 8100000000000
    m_Localized: "\xBFHas encontrado algo?"
    m_Metadata:
      m_Items: []
  - m_Id: 8200000000000
    m_Localized: "Cu\xEDdate ah\xED fuera."
    m_Metadata:
      m_Items: []
  - m_Id: 8300000000000
    m_Localized: ...Vuelve.
    m_Metadata:
      m_Items: []
  - m_Id: 8400000000000
    m_Localized: No tardo en olvidar lo que se siente cuando hay alguien cerca. No
      tardo.
    m_Metadata:
      m_Items: []
  - m_Id: 11432770195222528
    m_Localized: Hablar
    m_Metadata:
      m_Items: []
  - m_Id: 11433149075091456
    m_Localized: Adios
    m_Metadata:
      m_Items: []
  - m_Id: 11433369229914112
    m_Localized: Curar
    m_Metadata:
      m_Items: []
  - m_Id: 14242909021335552
    m_Localized: "Puede que a\xFAn pueda usar lo poco que queda del viento para sanar."
    m_Metadata:
      m_Items: []
  - m_Id: 14330350554116096
    m_Localized: "Si vuelves de ah\xED fuera\u2026 ven a la iglesia."
    m_Metadata:
      m_Items: []
  - m_Id: 14547915515686912
    m_Localized: "\u2026d\xE9jame ver."
    m_Metadata:
      m_Items: []
  - m_Id: 14548077587787776
    m_Localized: Te curare las heridas
    m_Metadata:
      m_Items: []
  - m_Id: 14548360053190656
    m_Localized: Te curare las heridas.
    m_Metadata:
      m_Items: []
  - m_Id: 14563846547632128
    m_Localized: "\u2026te estar\xE9 esperando."
    m_Metadata:
      m_Items: []
  - m_Id: 14564048343986176
    m_Localized: 'Ah... Toma esto para tus expediciones. '
    m_Metadata:
      m_Items: []
  - m_Id: 14677897961336832
    m_Localized: "\u2026Has vuelto."
    m_Metadata:
      m_Items: []
  - m_Id: 14678109299732480
    m_Localized: "No deber\xEDa ser posible\u2026 "
    m_Metadata:
      m_Items: []
  - m_Id: 14678421603414016
    m_Localized: "\u2026A\xFAn llevas algo \u2026De lo que ya no deber\xEDa existir."
    m_Metadata:
      m_Items: []
  - m_Id: 16045007289159680
    m_Localized: "Habla con Aldwyn para completar la misi\xF3n"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
