  m_TableData:
  - m_Id: 100000000000
    m_Localized: "\u8FD9\u4E2A\u5730\u65B9\u2026\u2026\u8FD8\u5728\u652F\u6491\u7740\u3002\u5B83\u6CA1\u6709\u6D3B\u7740\uFF0C\u4F46\u4E5F\u6CA1\u6709\u5B8C\u5168\u6B7B\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 200000000000
    m_Localized: "\u8FF7\u96FE\u6CA1\u6709\u7EC8\u7ED3\u5B83\u3002\u8FD9\u5F88\u7F55\u89C1\u3002\u800C\u4E14\u6709\u7528\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 300000000000
    m_Localized: "\u5468\u56F4\u6709\u88AB\u541E\u566C\u7684\u751F\u7269\u3002\u5B83\u4EEC\u672C\u8BE5\u505C\u6B62\u884C\u52A8\uFF0C\u5374\u4ECD\u5728\u79FB\u52A8\u3002\u53BB\u6D88\u706D\u5B83\u4EEC\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 400000000000
    m_Localized: "\u6211\u7684\u72E9\u730E\u4E4B\u6E34\u4E0D\u4F1A\u81EA\u5DF1\u5E73\u606F\u2026\u2026\u4F60\u7684\u4E5F\u4E0D\u8BE5\u3002\u82E5\u4F60\u5B8C\u6210\u2026\u2026\u6211\u4F1A\u7ED9\u4F60\u4E00\u628A\u4E0E\u4F60\u6218\u6597\u76F8\u79F0\u7684\u6B66\u5668\u3002\u4E0D\u591A\u4E0D\u5C11\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 500000000000
    m_Localized: "\u6211\u7684\u7FC5\u8180\u65E0\u6CD5\u81EA\u6108\u3002\u8FF7\u96FE\u4E0D\u4F1A\u6467\u6BC1\u2026\u2026\u5B83\u4F1A\u8150\u8680\u3002\u800C\u7834\u788E\u4E4B\u7269\uFF0C\u9700\u8981\u66F4\u5F3A\u7684\u4E1C\u897F\u624D\u80FD\u91CD\u65B0\u62FC\u5408\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 600000000000
    m_Localized: "\u8FD9\u7247\u571F\u5730\u4E0A\u6709\u4E00\u53EA\u51F6\u517D\u7684\u5C38\u4F53\u3002\u5B83\u7684\u5934\u9AA8\u5E94\u8BE5\u8FD8\u4FDD\u7559\u7740\u6211\u9700\u8981\u7684\u90E8\u5206\u3002\u628A\u5B83\u5E26\u7ED9\u6211\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 700000000000
    m_Localized: "\u4F60\u5E26\u6765\u4E86\u2026\u2026\u5B83\u4ECD\u7136\u6C89\u91CD\u5F97\u50CF\u662F\u5728\u5B88\u62A4\u4EC0\u4E48\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 800000000000
    m_Localized: "\u5F88\u597D\u3002\u591F\u7528\u4E86\u3002\u4E0D\u662F\u4E3A\u4E86\u7EAA\u5FF5\u5B83\u2026\u2026\u800C\u662F\u4E3A\u4E86\u91CD\u5EFA\u6211\u81EA\u5DF1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 900000000000
    m_Localized: "\u62FF\u7740\u3002\u8FD9\u628A\u6B66\u5668\u662F\u4F60\u7684\u3002\u4F46\u8FD9\u4E0D\u662F\u793C\u7269\uFF0C\u800C\u662F\u730E\u4EBA\u4E4B\u95F4\u7684\u503A\u52A1\u6E05\u507F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1000000000000
    m_Localized: "\u90A3\u5EA7\u6D1E\u7A74\u6709\u95EE\u9898\u2026\u2026\u751A\u81F3\u5BF9\u8FF7\u96FE\u800C\u8A00\u4E5F\u662F\u5982\u6B64\u3002\u90A3\u4E0D\u662F\u666E\u901A\u7684\u88AB\u541E\u566C\u8005\uFF0C\u5B83\u4EEC\u592A\u987D\u56FA\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1100000000000
    m_Localized: "\u8FDB\u53BB\uFF0C\u6D88\u706D\u4F60\u9047\u5230\u7684\u6700\u5F3A\u654C\u4EBA\u3002\u4E0D\u8BBA\u6709\u591A\u5C11\u3002"
