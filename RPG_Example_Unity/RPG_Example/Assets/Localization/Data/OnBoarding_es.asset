  m_TableData:
  - m_Id: 50354950144
    m_Localized: "\u2026Esos ojos\u2026 \xBFElira\u2026? No\u2026 no puede ser\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 69535502336
    m_Localized: "La niebla miente\u2026 pero tus ojos\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 71372607488
    m_Localized: "\u2026Sin Aurora\u2026 ya no puedo\u2026 distinguir la verdad\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 73222295552
    m_Localized: "\xA1Si eres real\u2026 habla\u2026 o muere!"
