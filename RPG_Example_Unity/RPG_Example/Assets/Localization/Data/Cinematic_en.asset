  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Cinematic_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 20321d82a12d51d44aa84212e150e253, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12815929344
    m_Localized: There was a time when Eryndor knew no chains.
    m_Metadata:
      m_Items: []
  - m_Id: 15655473152
    m_Localized: Kingdoms thrived beneath the covenant of the Eight Founding Mages.
    m_Metadata:
      m_Items: []
  - m_Id: 18398547968
    m_Localized: 'Their arts held the world together: the rune, the forge, the healing
      hand, the living earth... and above them all, the Light.'
    m_Metadata:
      m_Items: []
  - m_Id: 21057736704
    m_Localized: 'They called it the Golden Age. '
    m_Metadata:
      m_Items: []
  - m_Id: 25377869824
    m_Localized: And those who lived it believed it would never end.
    m_Metadata:
      m_Items: []
  - m_Id: 28519403520
    m_Localized: No one truly remembers how it fell.
    m_Metadata:
      m_Items: []
  - m_Id: 30490726400
    m_Localized: 'Only that one man reached too far...    '
    m_Metadata:
      m_Items: []
  - m_Id: 32181030912
    m_Localized: and that the darkness had been waiting for him all along.
    m_Metadata:
      m_Items: []
  - m_Id: 34420789248
    m_Localized: The light died slowly.
    m_Metadata:
      m_Items: []
  - m_Id: 36253700096
    m_Localized: And the world forgot it had ever been free.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
