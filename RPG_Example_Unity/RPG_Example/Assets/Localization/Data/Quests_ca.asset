  m_TableData:
  - m_Id: 124409581568
    m_Localized: Recull 20 Pols d'Aurora per encendre la foguera central del refugi.
    m_Metadata:
      m_Items: []
  - m_Id: 1211487121633280
    m_Localized: "Repara el pont de l'esgl\xE9sia."
    m_Metadata:
      m_Items: []
  - m_Id: 1211649785131008
    m_Localized: "Troba el pont que comunica amb l'esgl\xE9sia dins del poble de
      Fallowrest"
    m_Metadata:
      m_Items: []
  - m_Id: 1241254365556736
    m_Localized: "Recupera l'est\xE0tua d'una esgl\xE9sia perduda. I porta-la a l'Aldwyn."
    m_Metadata:
      m_Items: []
  - m_Id: 1670921245487104
    m_Localized: "Enc\xE9n la foguera amb les pols Aurora"
    m_Metadata:
      m_Items: []
  - m_Id: 1683367553200128
    m_Localized: Rescata els aldeanos perduts
    m_Metadata:
      m_Items: []
  - m_Id: 1859559430352896
    m_Localized: Recull 5 ossos petits dels consumits per regenerar les ales de la
      Naisha
    m_Metadata:
      m_Items: []
  - m_Id: 2019642244132864
    m_Localized: Recull Ossos Esquerdats Petits dels enemics
    m_Metadata:
      m_Items: []
  - m_Id: 2020244328083456
    m_Localized: Recull Banyes d'enemics perillosos
    m_Metadata:
      m_Items: []
