  m_TableData:
  - m_Id: 124409581568
    m_Localized: Recolecta 20 Polvos de Aurora para encender la hoguera central del
      refugio.
    m_Metadata:
      m_Items: []
  - m_Id: 1211487121633280
    m_Localized: Repara el puente de la iglesia.
    m_Metadata:
      m_Items: []
  - m_Id: 1211649785131008
    m_Localized: Encuentra el puente que comunica con la iglesia dentro de la aldea
      de Fallowrest
    m_Metadata:
      m_Items: []
  - m_Id: 1241254365556736
    m_Localized: Recupera la estatua de una iglesia perdida. Y llevala a Aldwyn.
    m_Metadata:
      m_Items: []
  - m_Id: 1670921245487104
    m_Localized: Enciende la hoguera con los polvos Aurora
    m_Metadata:
      m_Items: []
  - m_Id: 1683367553200128
    m_Localized: Rescata a los aldeanos perdidos
    m_Metadata:
      m_Items: []
  - m_Id: 1859559430352896
    m_Localized: "Recolecta 5 huesos peque\xF1os de los consumidos para regenerar
      las alas de Naisha"
    m_Metadata:
      m_Items: []
  - m_Id: 2019642244132864
