  m_TableData:
  - m_Id: 50354950144
    m_Localized: "\u2026Those eyes\u2026 Elira\u2026? No\u2026 it can\u2019t be\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 69535502336
    m_Localized: "The mist lies\u2026 but your eyes\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 71372607488
    m_Localized: "\u2026Without Aurora\u2026 I can no longer\u2026 tell truth from
      lies\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 73222295552
    m_Localized: "If you\u2019re real\u2026 speak\u2026 or die!"
    m_Metadata:
      m_Items: []
