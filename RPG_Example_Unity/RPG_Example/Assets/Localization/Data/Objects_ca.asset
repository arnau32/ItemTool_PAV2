  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Objects_ca
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: f1e2d3c4b5a697886950413223140506, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10000000000
    m_Localized: Pols brillant impregnada de llum antiga. Sembla mantenir la boira
      a ratlla\u2026 de moment.
    m_Metadata:
      m_Items: []
  - m_Id: 20000000000
    m_Localized: "Gema polida d'origen incert. El seu valor va m\xE9s enll\xE1 material."
    m_Metadata:
      m_Items: []
  - m_Id: 30000000000
    m_Localized: Est\u00e0tua desgastada de Liora. Encara conserva un eco del vent
      oblidat.
    m_Metadata:
      m_Items: []
  - m_Id: 40000000000
    m_Localized: Corda gastada pel temps. Encara pot sostenir m\u00e9s del que sembla.
    m_Metadata:
      m_Items: []
  - m_Id: 50000000000
    m_Localized: Restaura una petita quantitat de salut.
    m_Metadata:
      m_Items: []
  - m_Id: 60000000000
    m_Localized: Restaura una quantitat moderada de salut.
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000
    m_Localized: Restaura una gran quantitat de salut.
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000
    m_Localized: Carn sense tractar.
    m_Metadata:
      m_Items: []
  - m_Id: 90000000000
    m_Localized: Una mescla antiga de gran poder. Els seus efectes superen el conegut.
    m_Metadata:
      m_Items: []
  - m_Id: 100000000000
    m_Localized: Un os gran, trencat per\u00f2 resistent. Encara pot suportar pes.
    m_Metadata:
      m_Items: []
  - m_Id: 110000000000
    m_Localized: Estructura \u00f2ssia corba i s\u00f2lida. Perfecta per donar forma
      a alguna cosa m\u00e9s gran.
    m_Metadata:
      m_Items: []
  - m_Id: 120000000000
    m_Localized: "Metall b\xE0sic de forja. Resistent, mal\xB7leable i sempre \xFAtil."
    m_Metadata:
      m_Items: []
  - m_Id: 130000000000
    m_Localized: Un os fragil i esquerdat. Amb prou feines conserva la seva forma
      original.
    m_Metadata:
      m_Items: []
  - m_Id: 140000000000
    m_Localized: Fragment de roca resistent. Base de qualsevol estructura duradora.
    m_Metadata:
      m_Items: []
  - m_Id: 150000000000
    m_Localized: Fusta seca i lleugera. La fusta en bon estat \u00e9s escassa.
    m_Metadata:
      m_Items: []
  - m_Id: 3534277799636992
    m_Localized: "Pe\xE7a de carn de bona qualitat."
    m_Metadata:
      m_Items: []
  - m_Id: 3535889683247104
    m_Localized: "Poci\xF3 d\u2019Energia"
    m_Metadata:
      m_Items: []
  - m_Id: 3538622884671488
    m_Localized: "Poci\xF3 de For\xE7a"
    m_Metadata:
      m_Items: []
  - m_Id: 6475911524839424
    m_Localized: Manec d'espassa antic
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
