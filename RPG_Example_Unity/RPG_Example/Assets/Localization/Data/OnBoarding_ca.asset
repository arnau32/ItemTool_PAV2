  m_TableData:
  - m_Id: 50354950144
    m_Localized: "\u2026Aquests ulls\u2026 Elira\u2026? No\u2026 no pot ser\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 69535502336
    m_Localized: "La boira menteix\u2026 per\xF2 els teus ulls\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 71372607488
    m_Localized: "\u2026Sense Aurora\u2026 ja no puc\u2026 distingir la veritat\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 73222295552
    m_Localized: "Si ets real\u2026 parla\u2026 o mor!"
