  m_TableData:
  - m_Id: 37212450816
    m_Localized: "Bright dust imbued with ancient light. It seems to keep the mist
      at bay\u2026 for now."
    m_Metadata:
      m_Items: []
  - m_Id: 37304725504
    m_Localized: A polished gem of unknown origin. Its value goes beyond the material.
    m_Metadata:
      m_Items: []
  - m_Id: 37304725505
    m_Localized: A worn statue of Liora. It still holds an echo of forgotten wind.
    m_Metadata:
      m_Items: []
  - m_Id: 37304725506
    m_Localized: A rope worn by time. It can still hold more than it seems.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919808
    m_Localized: Restores a small amount of health.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919809
    m_Localized: Restores a moderate amount of health.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919810
    m_Localized: Restores a large amount of health.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919811
    m_Localized: Unprocessed meat.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919812
    m_Localized: An ancient mixture of great power. Its effects surpass the known.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919813
    m_Localized: "A large, cracked bone\u2014broken yet sturdy. It can still bear
      weight."
    m_Metadata:
      m_Items: []
  - m_Id: 37308919814
    m_Localized: A curved, solid bone structure. Perfect for shaping something greater.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919815
    m_Localized: Basic forging metal. Durable, malleable, and always useful.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919816
    m_Localized: A fragile, cracked bone. It barely retains its original form.
    m_Metadata:
      m_Items: []
  - m_Id: 37308919817
    m_Localized: A sturdy rock fragment. The foundation of any lasting structure.
    m_Metadata:
      m_Items: []
  - m_Id: 37313114112
    m_Localized: Dry, lightweight wood. Good timber is scarce.
    m_Metadata:
      m_Items: []
  - m_Id: 1395170046701568
    m_Localized: A vigorous mixture that restores stamina and eases exhaustion.
    m_Metadata:
      m_Items: []
  - m_Id: 1395612554162176
    m_Localized: An ancient formula that temporarily strengthens the body.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
